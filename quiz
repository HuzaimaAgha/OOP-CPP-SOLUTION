#include<iostream>
using namespace std;
class Library{
	string title;
	string author;
	int id;
	protected:
		Library(string title,string author,int id){
			this->title=title;
			this->author=author;
			this->id=id;
		}
		
		virtual void display(){
			cout<<"Title: "<<title<<endl;
			cout<<"Author:"<<author<<endl;
			cout<<"ID:"<<id<<endl;
		}
};
class Book:public Library{
	int numPages;
	string genre;
	public:
		Book(string title,string author,int id,int numPages,string genre):
		Library(title,author,id){
			this->genre=genre;
			this->numPages=numPages;
		}
		bool Long(){
			if(numPages>300){
				return true;
			}
			else{
				return false;
			}
		}
		void display()override{
			cout<<this->genre<<endl;
			cout<<this->numPages;
		}
};
class Magazine:public Library{
	int numIssue;
	int month;
	public:
		Magazine(string title,string author,int id,int numIssue,int month):
		Library(title,author,id){
			this->numIssue=numIssue;
			this->month=month;
		}
		void display()override{
			cout<<numIssue<<endl;
			cout<<month;
			
		}	
};
class AudioBook:public Library{
	int duration;
	string narrator;
	public:
		AudioBook(string title,string author,int id,int duration,string narrator):
			Library(title,author,id){
				this->duration=duration;
				this->narrator=narrator;
			}
		
		void display()override{
			cout<<this->duration<<endl;
			cout<<this->narrator;
		}
		bool time(){
			if(duration>60){
				return true;
			}
			else{
				return false;
			}
		
		}
		
};
int main(){
		Book b1("werty","qwedrf",123,1234,"asdf");
	Book b2("werty","qwedrf",123,1234,"asdf");
	if(b1.Long()){
		cout<<"This is a long material";
	}
	else{
		cout<<"this is a short reading material";
	}
	AudioBook a1("qwer","dfg",1234,123,"sadf");
	AudioBook a2("qwer","dfg",1234,123,"sadf");
	if(a1.time()){
		cout<<"This is a long material";
	}
	else{
		cout<<"this is a short reading material";
	}
	Magazine m1("asdf","asdfg",213,123,1234);
Magazine m2("asdf","asdfg",213,123,1234);
	
	
